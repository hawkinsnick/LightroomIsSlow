<Window x:Class="LightroomIsSlow.App.MainWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="LightroomIsSlow" Height="620" Width="820" MinHeight="560" MinWidth="720"><Grid Margin="28"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions><StackPanel><TextBlock Text="LightroomIsSlow" FontSize="30" FontWeight="SemiBold"/><TextBlock Text="Find out what is slowing Lightroom down." FontSize="16" Margin="0,5,0,20"/></StackPanel><Border Grid.Row="1" Padding="18" BorderThickness="1" CornerRadius="8"><StackPanel><TextBlock x:Name="DetectionText" Text="Checking for Lightroom…" FontSize="18" FontWeight="SemiBold"/><TextBlock x:Name="InstructionText" Text="Open Lightroom, then start recording. Use Lightroom normally until the slowdown happens." TextWrapping="Wrap" Margin="0,8,0,0"/></StackPanel></Border><StackPanel Grid.Row="2" Margin="0,22,0,0"><TextBlock Text="What are you doing in Lightroom?" FontWeight="SemiBold"/><ComboBox x:Name="Workload" SelectedIndex="0" Margin="0,7,0,18" Height="34"><ComboBoxItem Content="Not sure / general use"/><ComboBoxItem Content="Browsing Library"/><ComboBoxItem Content="Develop / editing"/><ComboBoxItem Content="Importing photos"/><ComboBoxItem Content="Exporting photos"/><ComboBoxItem Content="Generating previews"/><ComboBoxItem Content="AI Denoise"/><ComboBoxItem Content="AI masking"/><ComboBoxItem Content="Panorama / HDR"/><ComboBoxItem Content="Cloud sync"/></ComboBox><Button x:Name="RecordButton" Content="Start Recording" Height="52" FontSize="18" Click="Record_Click"/><TextBlock x:Name="StatusText" Text="Nothing is being recorded yet." Margin="0,16,0,0" TextWrapping="Wrap"/><TextBlock Text="LightroomIsSlow only observes your computer. It does not change Windows or Lightroom settings." Margin="0,24,0,0" TextWrapping="Wrap"/></StackPanel><StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Right"><Button Content="Create Support ZIP" Padding="14,8" Click="Support_Click"/><Button Content="Open Sessions Folder" Margin="10,0,0,0" Padding="14,8" Click="OpenSessions_Click"/><Button Content="Refresh Lightroom Detection" Margin="10,0,0,0" Padding="14,8" Click="Refresh_Click"/></StackPanel></Grid></Window>